// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
indicator("Range Duration Detector", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ─── Timeframe Guard (>= 4H only) ───────────────────────────────────────────
if timeframe.in_seconds() < 14400
    runtime.error("Requires 4H timeframe or higher. Current: " + timeframe.period)

// ─── Inputs ──────────────────────────────────────────────────────────────────
seedBars         = input.int(15,    "Seed Bars",                 minval=5,   maxval=60,   group="Range Detection", tooltip="Bars checked to detect initial range forming")
maxRangePct      = input.float(12.0,"Max Range Width %",         minval=2.0, maxval=40.0, step=0.5, group="Range Detection", tooltip="Max distance between range high/low as % of low")
breakoutConfirm  = input.int(3,     "Breakout Confirm Bars",     minval=2,   maxval=10,   group="Range Detection", tooltip="Consecutive closes outside to confirm breakout")
excursionPct     = input.float(1.5, "Excursion Tolerance %",     minval=0.0, maxval=5.0,  step=0.25, group="Range Detection", tooltip="% beyond boundaries still counted as inside")
minRangeBars     = input.int(15,    "Min Range Duration (bars)", minval=5,   maxval=200,  group="Range Detection")
cooldownLen      = input.int(5,     "Cooldown After Breakout",   minval=0,   maxval=30,   group="Range Detection")
mergeGapBars     = input.int(15,    "Merge Gap (bars)",          minval=3,   maxval=50,   group="Range Detection", tooltip="If a new range overlaps in price with the previous and the gap is within this many bars, they merge into one")
mergeMaxPct      = input.float(18.0,"Merge Max Width %",         minval=5.0, maxval=50.0, step=1.0, group="Range Detection", tooltip="Maximum allowed width of a merged range as %. Prevents chain-merging into one giant box")
maLongLen        = input.int(200,   "Long Trend MA",             minval=50,  maxval=500,  group="Forecast", tooltip="Long-term MA for macro trend detection")
maShortLen       = input.int(50,    "Short Trend MA",            minval=10,  maxval=200,  group="Forecast", tooltip="Short-term MA for recent momentum")
slopeLen         = input.int(10,    "Slope Lookback",            minval=5,   maxval=50,   group="Forecast", tooltip="Bars to measure MA slope over")
maxDisplay       = input.int(10,    "Max Ranges to Display",     minval=1,   maxval=50,   group="Display")
showStats        = input.bool(true, "Show Stats Table",          group="Display")
showForecast     = input.bool(true, "Show Forecast Panel",       group="Display")
showProjection   = input.bool(true, "Show Breakout Projection",  group="Display", tooltip="Draw projected breakout time and direction on active range")
rangeCol         = input.color(color.new(color.blue, 75),   "Range Color",         group="Colors")
activeCol        = input.color(color.new(color.orange, 70),  "Active Range Color",  group="Colors")
breakUpCol       = input.color(color.new(color.green, 75),   "Breakout Up Color",   group="Colors")
breakDnCol       = input.color(color.new(color.red, 75),     "Breakout Down Color", group="Colors")

// ─── State Variables ─────────────────────────────────────────────────────────
var bool  inRange        = false
var float rHigh          = na
var float rLow           = na
var int   rangeStartBar  = 0
var int   rangeStartTime = 0
var int   outsideCount   = 0
var int   cooldown       = 0

// ─── Storage Arrays ──────────────────────────────────────────────────────────
var array<int>   aDur = array.new_int()
var array<float> aHi  = array.new_float()
var array<float> aLo  = array.new_float()
var array<int>   aST  = array.new_int()
var array<int>   aET  = array.new_int()
var array<int>   aSB  = array.new_int()
var array<int>   aEB  = array.new_int()
var array<int>   aDir = array.new_int()
var array<float> aSz  = array.new_float()

// ─── Seed Detection ──────────────────────────────────────────────────────────
seedHigh     = ta.highest(close, seedBars)
seedLow      = ta.lowest(close, seedBars)
seedWidthPct = (seedHigh - seedLow) / seedLow * 100.0

// ─── Range State Machine ─────────────────────────────────────────────────────
if not inRange
    if cooldown > 0
        cooldown -= 1
    else if seedWidthPct <= maxRangePct
        inRange        := true
        rangeStartBar  := bar_index - seedBars + 1
        rangeStartTime := time[seedBars - 1]
        rHigh          := seedHigh
        rLow           := seedLow
        outsideCount   := 0
else
    float paddedHigh = rHigh * (1.0 + excursionPct / 100.0)
    float paddedLow  = rLow  * (1.0 - excursionPct / 100.0)

    if close <= paddedHigh and close >= paddedLow
        outsideCount := 0
        float nH = math.max(rHigh, close)
        float nL = math.min(rLow, close)
        if (nH - nL) / nL * 100.0 <= maxRangePct
            rHigh := nH
            rLow  := nL
    else
        outsideCount += 1
        if outsideCount >= breakoutConfirm
            int   endBar  = bar_index - outsideCount
            int   dur     = endBar - rangeStartBar
            int   endTime = time[outsideCount]

            if dur >= minRangeBars
                int breakDir = close > rHigh ? 1 : (close < rLow ? -1 : 0)

                bool merged = false
                if array.size(aDur) > 0
                    int   lastI   = array.size(aDur) - 1
                    float prevH   = array.get(aHi, lastI)
                    float prevL   = array.get(aLo, lastI)
                    int   prevEB  = array.get(aEB, lastI)
                    int   gap     = rangeStartBar - prevEB
                    float ovlpTop = math.min(rHigh, prevH)
                    float ovlpBot = math.max(rLow, prevL)
                    float ovlpSz  = math.max(0.0, ovlpTop - ovlpBot)
                    float smaller = math.min(rHigh - rLow, prevH - prevL)
                    bool  hasOvlp = smaller > 0 ? ovlpSz / smaller >= 0.15 : false
                    float unionH  = math.max(rHigh, prevH)
                    float unionL  = math.min(rLow, prevL)
                    float unionPct = (unionH - unionL) / unionL * 100.0

                    if hasOvlp and gap <= mergeGapBars and unionPct <= mergeMaxPct
                        int origSB = array.get(aSB, lastI)
                        array.set(aDur, lastI, endBar - origSB)
                        array.set(aHi,  lastI, unionH)
                        array.set(aLo,  lastI, unionL)
                        array.set(aET,  lastI, endTime)
                        array.set(aEB,  lastI, endBar)
                        array.set(aDir, lastI, breakDir)
                        array.set(aSz,  lastI, unionPct)
                        merged := true

                if not merged
                    array.push(aDur, dur)
                    array.push(aHi,  rHigh)
                    array.push(aLo,  rLow)
                    array.push(aST,  rangeStartTime)
                    array.push(aET,  endTime)
                    array.push(aSB,  rangeStartBar)
                    array.push(aEB,  endBar)
                    array.push(aDir, breakDir)
                    array.push(aSz,  (rHigh - rLow) / rLow * 100.0)
                    if array.size(aDur) > 200
                        array.shift(aDur)
                        array.shift(aHi)
                        array.shift(aLo)
                        array.shift(aST)
                        array.shift(aET)
                        array.shift(aSB)
                        array.shift(aEB)
                        array.shift(aDir)
                        array.shift(aSz)

            inRange  := false
            cooldown := cooldownLen

// ─── Active range duration ───────────────────────────────────────────────────
activeDur = inRange ? bar_index - rangeStartBar : 0

// ─── Helpers ─────────────────────────────────────────────────────────────────
durationText(int bars) =>
    float totalMins = bars * timeframe.in_seconds() / 60.0
    int   d = int(totalMins / 1440.0)
    int   h = int((totalMins - d * 1440.0) / 60.0)
    d > 0 ? str.tostring(d) + "d" + (h > 0 ? " " + str.tostring(h) + "h" : "") : str.tostring(h) + "h"

midTime(int t1, int t2) =>
    t1 + (t2 - t1) / 2

// ─── Statistics ──────────────────────────────────────────────────────────────
int   total     = array.size(aDur)
float avgDur    = total > 0 ? array.avg(aDur)    : 0.0
float medDur    = total > 0 ? array.median(aDur)  : 0.0
int   maxDurVal = total > 0 ? array.max(aDur)     : 0
int   minDurVal = total > 0 ? array.min(aDur)     : 0
float avgSz     = total > 0 ? array.avg(aSz)      : 0.0

int upBreaks  = 0
int dnBreaks  = 0
if total > 0
    for i = 0 to total - 1
        int d = array.get(aDir, i)
        if d == 1
            upBreaks += 1
        else if d == -1
            dnBreaks += 1

int   recentN   = math.min(5, total)
float recentAvg = 0.0
if recentN > 0
    int rSum = 0
    for i = total - recentN to total - 1
        rSum += array.get(aDur, i)
    recentAvg := rSum / recentN

// ─── SENTIMENT & FORECAST ENGINE ─────────────────────────────────────────────
// Moving averages
float maLong     = ta.sma(close, maLongLen)
float maShort    = ta.sma(close, maShortLen)
float rsiVal     = ta.rsi(close, 14)
float volMA      = ta.sma(volume, 20)
float volShort   = ta.sma(volume, 5)

// MA slopes (% change over slopeLen bars)
float maLongSlope  = not na(maLong[slopeLen])  ? (maLong  - maLong[slopeLen])  / maLong[slopeLen]  * 100.0 : 0.0
float maShortSlope = not na(maShort[slopeLen]) ? (maShort - maShort[slopeLen]) / maShort[slopeLen] * 100.0 : 0.0

// ─── Score components (each -1.0 to +1.0, weighted later) ───────────────────
// 1. Long-term trend: 200 MA slope
float sigLongTrend = math.max(-1.0, math.min(1.0, maLongSlope / 2.0))

// 2. Short-term momentum: 50 MA slope
float sigShortTrend = math.max(-1.0, math.min(1.0, maShortSlope / 1.5))

// 3. Price vs long MA: above = bullish, below = bearish
float priceVsMaPct = not na(maLong) ? (close - maLong) / maLong * 100.0 : 0.0
float sigPriceVsMa = math.max(-1.0, math.min(1.0, priceVsMaPct / 10.0))

// 4. MA alignment: short above long = bullish structure
float maCrossSig = not na(maLong) and not na(maShort) ? (maShort - maLong) / maLong * 100.0 : 0.0
float sigMaAlign = math.max(-1.0, math.min(1.0, maCrossSig / 5.0))

// 5. Historical breakout bias (all ranges)
float sigHistBias = total > 2 ? math.max(-1.0, math.min(1.0, (upBreaks - dnBreaks) / (total * 0.5))) : 0.0

// 6. Recent 3 ranges breakout bias
int   rec3Up  = 0
int   rec3Dn  = 0
int   rec3N   = math.min(3, total)
if rec3N > 0
    for i = total - rec3N to total - 1
        int dd = array.get(aDir, i)
        if dd == 1
            rec3Up += 1
        else if dd == -1
            rec3Dn += 1
float sigRecentBias = rec3N > 0 ? (rec3Up - rec3Dn) / float(rec3N) : 0.0

// 7. RSI: oversold = bullish bounce likely, overbought = bearish
float sigRsi = rsiVal < 35 ? math.max(0.0, (35.0 - rsiVal) / 20.0) : (rsiVal > 65 ? math.min(0.0, (65.0 - rsiVal) / 20.0) : 0.0)

// 8. Volume trend: rising vol = breakout imminent, combined with price position
float sigVolume = 0.0
if inRange and not na(rHigh) and not na(rLow) and rHigh > rLow
    float rangePos = (close - rLow) / (rHigh - rLow)
    float volRatio = volMA > 0 ? volShort / volMA : 1.0
    if volRatio > 1.2
        sigVolume := rangePos > 0.6 ? 0.5 : (rangePos < 0.4 ? -0.5 : 0.0)

// ─── Weighted composite score (-100 to +100) ────────────────────────────────
float score = 0.0
score += sigLongTrend  * 25.0    // macro trend is heaviest
score += sigShortTrend * 15.0    // recent momentum
score += sigPriceVsMa  * 15.0    // structural position
score += sigMaAlign    * 10.0    // MA alignment
score += sigHistBias   * 10.0    // what ranges historically do
score += sigRecentBias * 10.0    // what recent ranges did
score += sigRsi        * 8.0     // oversold/overbought
score += sigVolume     * 7.0     // volume + position
score := math.max(-100.0, math.min(100.0, score))

// ─── Derived forecast values ─────────────────────────────────────────────────
float upProb       = 50.0 + score / 2.0
float dnProb       = 100.0 - upProb
string dirLabel    = score > 15 ? "BULLISH ↑" : (score < -15 ? "BEARISH ↓" : "NEUTRAL →")
color  dirColor    = score > 15 ? color.green : (score < -15 ? color.red : color.gray)
string confLabel   = math.abs(score) > 60 ? "HIGH" : (math.abs(score) > 30 ? "MEDIUM" : "LOW")
color  confColor   = math.abs(score) > 60 ? color.green : (math.abs(score) > 30 ? color.orange : color.gray)
string trendLabel  = maLongSlope > 0.3 ? "UPTREND" : (maLongSlope < -0.3 ? "DOWNTREND" : "SIDEWAYS")
color  trendColor  = maLongSlope > 0.3 ? color.green : (maLongSlope < -0.3 ? color.red : color.gray)

// Breakout timing (only meaningful when in a range)
int   barsLeft     = inRange and avgDur > 0 ? int(math.max(0, math.round(avgDur) - activeDur)) : 0
float progressPct  = inRange and avgDur > 0 ? math.min(100.0, activeDur / avgDur * 100.0) : 0.0
string progressBar = ""
if inRange and avgDur > 0
    int filled = int(progressPct / 10.0)
    int empty  = 10 - filled
    for _i = 0 to filled - 1
        progressBar += "█"
    for _i = 0 to empty - 1
        progressBar += "░"

// ─── Draw Range Boxes ────────────────────────────────────────────────────────
if barstate.islast
    int tCount = array.size(aDur)
    int iStart = math.max(0, tCount - maxDisplay)

    if tCount > 0
        for i = iStart to tCount - 1
            int   t1  = array.get(aST, i)
            int   t2  = array.get(aET, i)
            float cH  = array.get(aHi, i)
            float cL  = array.get(aLo, i)
            int   dur = array.get(aDur, i)
            int   dir = array.get(aDir, i)
            float sz  = array.get(aSz, i)
            color col = dir == 1 ? breakUpCol : (dir == -1 ? breakDnCol : rangeCol)
            box.new(t1, cH, t2, cL, border_color=color.new(col, 30), bgcolor=col, border_width=1, xloc=xloc.bar_time)
            int mid = midTime(t1, t2)
            string arrow = dir == 1 ? " ↑" : (dir == -1 ? " ↓" : "")
            label.new(mid, cH, durationText(dur) + arrow, xloc=xloc.bar_time, color=color.new(col, 30), textcolor=color.white, style=label.style_label_down, size=size.small)
            label.new(mid, cL, str.tostring(math.round(sz, 1)) + "% range", xloc=xloc.bar_time, color=color.new(col, 30), textcolor=color.white, style=label.style_label_up, size=size.tiny)

    // Active range box + breakout projection
    if inRange and activeDur >= minRangeBars
        box.new(rangeStartTime, rHigh, time, rLow, border_color=color.new(activeCol, 20), bgcolor=activeCol, border_width=2, xloc=xloc.bar_time)
        label.new(midTime(rangeStartTime, time), rHigh, durationText(activeDur) + " [ACTIVE]", xloc=xloc.bar_time, color=color.new(activeCol, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

        // Projected breakout line
        if showProjection and avgDur > 0 and barsLeft > 0
            int projTime = time + barsLeft * timeframe.in_seconds() * 1000
            line.new(projTime, rLow, projTime, rHigh, xloc=xloc.bar_time, color=color.yellow, style=line.style_dashed, width=2)
            string projTxt = "~" + durationText(barsLeft) + " left"
            label.new(projTime, rHigh, projTxt, xloc=xloc.bar_time, color=color.new(color.yellow, 30), textcolor=color.white, style=label.style_label_down, size=size.tiny)

            // Direction arrow at projected breakout
            float arrowPrice = score > 15 ? rHigh : (score < -15 ? rLow : (rHigh + rLow) / 2.0)
            color  arrowCol  = score > 15 ? color.green : (score < -15 ? color.red : color.gray)
            string arrowTxt  = score > 15 ? "▲ " + str.tostring(math.round(upProb, 0)) + "%" : (score < -15 ? "▼ " + str.tostring(math.round(dnProb, 0)) + "%" : "◆ 50/50")
            label.new(projTime, arrowPrice, arrowTxt, xloc=xloc.bar_time, color=color.new(arrowCol, 20), textcolor=color.white, style=score > 15 ? label.style_label_up : label.style_label_down, size=size.small)

// ─── Stats Table ─────────────────────────────────────────────────────────────
if showStats and barstate.islast
    var table tbl = table.new(position.top_right, 2, 12, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    color hBg = color.new(#1a1a2e, 0)
    color r1  = color.new(#16213e, 0)
    color r2  = color.new(#0f3460, 0)

    table.cell(tbl, 0, 0,  "RANGE STATS",       bgcolor=hBg, text_color=color.orange, text_size=size.small)
    table.cell(tbl, 1, 0,  syminfo.ticker,       bgcolor=hBg, text_color=color.orange, text_size=size.small)
    table.cell(tbl, 0, 1,  "Total Ranges",       bgcolor=r1, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1,  str.tostring(total),  bgcolor=r1, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 2,  "Avg Duration",       bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2,  durationText(int(math.round(avgDur))) + " (" + str.tostring(math.round(avgDur, 1)) + " bars)", bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3,  "Median Duration",    bgcolor=r1, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3,  durationText(int(math.round(medDur))) + " (" + str.tostring(math.round(medDur, 1)) + " bars)", bgcolor=r1, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 4,  "Shortest / Longest", bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4,  durationText(minDurVal) + " / " + durationText(maxDurVal), bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 5,  "Recent 5 Avg",       bgcolor=r1, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5,  durationText(int(math.round(recentAvg))) + " (" + str.tostring(math.round(recentAvg, 1)) + " bars)", bgcolor=r1, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 6,  "Avg Range Width",    bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 6,  str.tostring(math.round(avgSz, 2)) + "%", bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 7,  "Breakout Up",        bgcolor=r1, text_color=color.green, text_size=size.small)
    float pctUp = total > 0 ? upBreaks / total * 100.0 : 0.0
    table.cell(tbl, 1, 7,  str.tostring(upBreaks) + " (" + str.tostring(math.round(pctUp, 1)) + "%)", bgcolor=r1, text_color=color.green, text_size=size.small)
    table.cell(tbl, 0, 8,  "Breakout Down",      bgcolor=r2, text_color=color.red, text_size=size.small)
    float pctDn = total > 0 ? dnBreaks / total * 100.0 : 0.0
    table.cell(tbl, 1, 8,  str.tostring(dnBreaks) + " (" + str.tostring(math.round(pctDn, 1)) + "%)", bgcolor=r2, text_color=color.red, text_size=size.small)
    table.cell(tbl, 0, 9,  "Status",             bgcolor=r1, text_color=color.white, text_size=size.small)
    string stTxt = inRange ? "IN RANGE (" + durationText(activeDur) + ")" : "TRENDING"
    color  stCol = inRange ? color.orange : color.aqua
    table.cell(tbl, 1, 9,  stTxt, bgcolor=r1, text_color=stCol, text_size=size.small)
    table.cell(tbl, 0, 10, "Typical Duration",    bgcolor=r2, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 10, "~" + durationText(int(math.round(avgDur))) + " then breakout", bgcolor=r2, text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 0, 11, "Timeframe",           bgcolor=hBg, text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 11, timeframe.period,       bgcolor=hBg, text_color=color.gray, text_size=size.tiny)

// ─── Forecast Table ──────────────────────────────────────────────────────────
if showForecast and barstate.islast
    var table ftbl = table.new(position.bottom_right, 2, 10, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    color fHBg = color.new(#1a1a2e, 0)
    color fR1  = color.new(#16213e, 0)
    color fR2  = color.new(#0f3460, 0)

    table.cell(ftbl, 0, 0, "FORECAST",            bgcolor=fHBg, text_color=color.yellow, text_size=size.small)
    table.cell(ftbl, 1, 0, syminfo.ticker,         bgcolor=fHBg, text_color=color.yellow, text_size=size.small)

    table.cell(ftbl, 0, 1, "Macro Trend",          bgcolor=fR1, text_color=color.white, text_size=size.small)
    table.cell(ftbl, 1, 1, trendLabel,              bgcolor=fR1, text_color=trendColor, text_size=size.small)

    table.cell(ftbl, 0, 2, "200 MA Slope",         bgcolor=fR2, text_color=color.white, text_size=size.small)
    color slopeCol = maLongSlope > 0 ? color.green : color.red
    table.cell(ftbl, 1, 2, str.tostring(math.round(maLongSlope, 2)) + "%", bgcolor=fR2, text_color=slopeCol, text_size=size.small)

    table.cell(ftbl, 0, 3, "50 MA Slope",          bgcolor=fR1, text_color=color.white, text_size=size.small)
    color slopeCol2 = maShortSlope > 0 ? color.green : color.red
    table.cell(ftbl, 1, 3, str.tostring(math.round(maShortSlope, 2)) + "%", bgcolor=fR1, text_color=slopeCol2, text_size=size.small)

    table.cell(ftbl, 0, 4, "Price vs 200 MA",      bgcolor=fR2, text_color=color.white, text_size=size.small)
    string pvmTxt = not na(maLong) ? (close > maLong ? "ABOVE +" : "BELOW ") + str.tostring(math.round(math.abs(priceVsMaPct), 1)) + "%" : "N/A"
    color  pvmCol = priceVsMaPct > 0 ? color.green : color.red
    table.cell(ftbl, 1, 4, pvmTxt,                  bgcolor=fR2, text_color=pvmCol, text_size=size.small)

    table.cell(ftbl, 0, 5, "Breakout Direction",    bgcolor=fR1, text_color=color.white, text_size=size.small)
    table.cell(ftbl, 1, 5, dirLabel,                 bgcolor=fR1, text_color=dirColor, text_size=size.small)

    table.cell(ftbl, 0, 6, "Probability",           bgcolor=fR2, text_color=color.white, text_size=size.small)
    string probTxt = "↑ " + str.tostring(math.round(upProb, 0)) + "% / ↓ " + str.tostring(math.round(dnProb, 0)) + "%"
    table.cell(ftbl, 1, 6, probTxt,                  bgcolor=fR2, text_color=dirColor, text_size=size.small)

    table.cell(ftbl, 0, 7, "Confidence",            bgcolor=fR1, text_color=color.white, text_size=size.small)
    table.cell(ftbl, 1, 7, confLabel + " (" + str.tostring(math.round(math.abs(score), 0)) + "/100)", bgcolor=fR1, text_color=confColor, text_size=size.small)

    table.cell(ftbl, 0, 8, "Range Progress",        bgcolor=fR2, text_color=color.white, text_size=size.small)
    string progTxt = inRange and avgDur > 0 ? progressBar + " " + str.tostring(math.round(progressPct, 0)) + "%" : "Not in range"
    color  progCol = progressPct > 80 ? color.red : (progressPct > 50 ? color.orange : color.aqua)
    table.cell(ftbl, 1, 8, progTxt,                   bgcolor=fR2, text_color=inRange ? progCol : color.gray, text_size=size.small)

    table.cell(ftbl, 0, 9, "Est. Breakout In",      bgcolor=fR1, text_color=color.white, text_size=size.small)
    string estTxt = inRange and barsLeft > 0 ? "~" + durationText(barsLeft) : (inRange and barsLeft == 0 ? "OVERDUE — NOW" : "Not in range")
    color  estCol = inRange and barsLeft == 0 ? color.red : (inRange ? color.yellow : color.gray)
    table.cell(ftbl, 1, 9, estTxt,                    bgcolor=fR1, text_color=estCol, text_size=size.small)

// ─── Alerts ──────────────────────────────────────────────────────────────────
alertcondition(not inRange[1] and inRange,  "Range Started",  "Price entered consolidation range")
alertcondition(inRange[1] and not inRange,  "Range Breakout", "Price broke out of consolidation range")
alertcondition(inRange and activeDur == int(math.round(avgDur)) and avgDur > 0, "At Avg Duration", "Range reached typical duration — breakout likely soon")
alertcondition(inRange and barsLeft == 0 and avgDur > 0, "Breakout Overdue", "Range exceeded average duration — breakout imminent")
